    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.471.2",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "2.15.4",
    "tailwind-merge": "2.6.1",
    "zod": "3.25.76"
